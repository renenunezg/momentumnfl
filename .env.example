# Direct Postgres to the shared momentum Supabase project (nfl schema)
DATABASE_URL=
# The Odds API
ODDS_API_KEY=
ODDS_API_REGIONS=us
# Up to 10 books bill as one region; Pinnacle is the sharp reference.
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm,pinnacle
# Set to 1 to allow production DB writes from a local shell (CI sets GITHUB_ACTIONS)
MOMENTUMNFL_DB_WRITES=
